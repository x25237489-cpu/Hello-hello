
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f8fafc">
  <meta name="description" content="Peter's personal page - MSc student at National College of Ireland.">
  <title>Peter | Business Analytics</title>

  <style>
    :root {
      --background: #f8fafc;
      --surface: #ffffff;
      --text: #172033;
      --muted: #64748b;
      --accent: #2563eb;
      --border: #e2e8f0;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--background);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont,
                   "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    main {
      width: 100%;
      max-width: 580px;
      padding: clamp(28px, 7vw, 56px);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: 0 16px 50px rgba(15, 23, 42, 0.05);
    }

    .eyebrow {
      margin: 0 0 20px;
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.8rem, 10vw, 4.5rem);
      font-weight: 750;
      letter-spacing: -0.055em;
      line-height: 1.1;
    }

    .subtitle {
      margin: 16px 0 0;
      color: var(--muted);
      font-size: clamp(1rem, 3vw, 1.15rem);
      line-height: 1.6;
    }

    .divider {
      width: 48px;
      height: 4px;
      margin: 36px 0;
      border-radius: 4px;
      background: var(--accent);
    }

    .section-label {
      margin: 0 0 12px;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .interest {
      margin: 0;
      font-size: clamp(1.1rem, 3vw, 1.35rem);
      font-weight: 500;
      line-height: 1.7;
    }

    footer {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 48px;
      padding-top: 22px;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.85rem;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      flex-shrink: 0;
      border-radius: 50%;
      background: #16a34a;
    }

    @media (max-width: 480px) {
      body {
        padding: 16px;
      }

      main {
        border-radius: 20px;
      }

      .divider {
        margin: 28px 0;
      }

      footer {
        margin-top: 36px;
      }
    }
  </style>
</head>

<body>
  <main>
    <p class="eyebrow">A little about me</p>

    <h1>Hi, I'm Peter<span style="color: #2563eb;">.</span></h1>

    <p class="subtitle">
      MSc student, National College of Ireland
    </p>

    <div class="divider" aria-hidden="true"></div>

    <section aria-labelledby="interest-heading">
      <h2 class="section-label" id="interest-heading">
        What I care about
      </h2>

      <p class="interest">
        I'm interested in using data analytics to help
        financial institutions detect fraud, identify
        suspicious transactions, and make better decisions.
      </p>
    </section>

    <footer>
      <span class="status-dot" aria-hidden="true"></span>
      <span>Today is <time id="today">3 November 2026</time></span>
    </footer>
  </main>

  <script>
    const today = new Date();

    const formattedDate = new Intl.DateTimeFormat("en-IE", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "Europe/Dublin"
    }).format(today);

    const dateElement = document.getElementById("today");

    dateElement.textContent = formattedDate;

    const dateParts = new Intl.DateTimeFormat("en-GB", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      timeZone: "Europe/Dublin"
    }).formatToParts(today);

    const getPart = (type) =>
      dateParts.find(part => part.type === type).value;

    dateElement.dateTime =
      `${getPart("year")}-${getPart("month")}-${getPart("day")}`;
  </script>
</body>
</html>
